# ========================================================
# JogoPawon Backend Environment Configuration Template
# ========================================================
# Rename this file to .env and fill with your actual credentials

PORT=8080
NODE_ENV=production

# Supabase REST API & Realtime Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# PostgreSQL Direct Database Connection
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Cloudflare R2 Object Storage (Upload Bukti Bayar & Foto Produk)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_BUCKET_NAME=your-r2-bucket-name
CLOUDFLARE_R2_PUBLIC_URL=https://your-public-r2-url.r2.dev
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# Admin Authentication
ADMIN_PASSWORD=your_secure_admin_password
